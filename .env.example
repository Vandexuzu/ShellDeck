# ShellDeck configuration — copy to .env and edit.
APP_NAME=ShellDeck

# JWT signing + credential encryption key. CHANGE THIS to a long random string!
SECRET_KEY=change-me-to-a-long-random-string

# Token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite by default; can be postgresql://... for larger setups)
DATABASE_URL=sqlite:///./shelldeck.db

# Bind address / port (used by Docker)
HOST=0.0.0.0
PORT=8000

# Skip SSH host-key checking. Homelab-friendly but weaker MITM protection.
# Set to false in production.
SSH_IGNORE_KNOWN_HOSTS=true
