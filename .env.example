# ---- App ----
APP_NAME=ShellDeck
# Secret used for JWT signing. CHANGE THIS in production!
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Database ----
# SQLite file (git-ignored). Relative to project root.
DATABASE_URL=sqlite:///./shelldeck.db

# ---- Host / Port (used by docker-compose) ----
HOST=0.0.0.0
PORT=8000
